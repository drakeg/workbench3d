{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workbench3D",
  "version": "0.3.0",
  "identifier": "io.github.drakeg.workbench3d",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Workbench3D",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false,
        "label": "main",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 13
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Push/pull 3D modeling for makers",
    "longDescription": "Workbench3D is an open-source 3D modeler for woodworking, welding and fabrication, home and RV interior design.",
    "fileAssociations": [
      {
        "ext": [
          "wb3d"
        ],
        "name": "Workbench3D model",
        "description": "Workbench3D model",
        "role": "Editor",
        "mimeType": "application/x-workbench3d"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}