{
  "name": "workbench3d",
  "version": "0.2.0",
  "description": "Open-source 3D modeler for woodworking, welding, home and RV interior design. Push/pull modeling in the browser or as a desktop app.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "smoke": "node scripts/smoke.mjs",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drakeg/workbench3d"
  },
  "keywords": [
    "3d",
    "modeling",
    "cad",
    "woodworking",
    "welding",
    "rv",
    "push-pull",
    "threejs",
    "tauri"
  ]
}
